{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/disclosure/**",
              "components/filters/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bebas Neue|Inter))/i]",
        "message": "Font not provided by the design system. Available: Bebas Neue, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|fullWidth|disabled|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, fullWidth, disabled, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|on-image)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'on-image'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CampaignTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|headline|body|ctaLabel|onCta|secondaryCtaLabel|onSecondaryCta|tone|align|aspectRatio|minHeight|style|key|ref|className|style|children)$/]",
        "message": "<CampaignTile> doesn't accept that prop. Declared props: image, headline, body, ctaLabel, onCta, secondaryCtaLabel, onSecondaryCta, tone, align, aspectRatio, minHeight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CampaignTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<CampaignTile> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CampaignTile'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:bottom-left|top-left)$/]",
        "message": "<CampaignTile> align must be one of 'bottom-left' | 'top-left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryIconCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|image|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CategoryIconCard> doesn't accept that prop. Declared props: icon, image, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisclosureRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|count|variant|defaultOpen|children|style|key|ref|className|style|children)$/]",
        "message": "<DisclosureRow> doesn't accept that prop. Declared props: label, count, variant, defaultOpen, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisclosureRow'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:pdp|faq)$/]",
        "message": "<DisclosureRow> variant must be one of 'pdp' | 'faq'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: active, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|count|active|key|ref|className|style|children)$/]",
        "message": "<FilterOption> doesn't accept that prop. Declared props: label, count, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|size|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, size, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|ghost|canvas|inverse)$/]",
        "message": "<IconButton> variant must be one of 'soft' | 'ghost' | 'canvas' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MemberBenefitCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|ctaLabel|onCta|aspectRatio|style|key|ref|className|style|children)$/]",
        "message": "<MemberBenefitCard> doesn't accept that prop. Declared props: image, title, ctaLabel, onCta, aspectRatio, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavDrawer'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|links|onNavigate|footer|contained|style|key|ref|className|style|children)$/]",
        "message": "<NavDrawer> doesn't accept that prop. Declared props: open, onClose, links, onNavigate, footer, contained, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:price|originalPrice|discount|size|style|key|ref|className|style|children)$/]",
        "message": "<PriceRow> doesn't accept that prop. Declared props: price, originalPrice, discount, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceRow'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<PriceRow> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PrimaryNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|links|active|onNavigate|onBrand|onSearch|onMenu|onAction|actions|compact|style|key|ref|className|style|children)$/]",
        "message": "<PrimaryNav> doesn't accept that prop. Declared props: brand, links, active, onNavigate, onBrand, onSearch, onMenu, onAction, actions, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|imageAlt|placeholder|name|subtitle|colorCount|price|originalPrice|discount|badge|swatches|aspectRatio|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: image, imageAlt, placeholder, name, subtitle, colorCount, price, originalPrice, discount, badge, swatches, aspectRatio, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|defaultValue|placeholder|onChange|onSubmit|width|collapsed|onExpand|autoFocus|style|key|ref|className|style|children)$/]",
        "message": "<SearchPill> doesn't accept that prop. Declared props: value, defaultValue, placeholder, onChange, onSubmit, width, collapsed, onExpand, autoFocus, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:breadcrumb|title|count|filtersVisible|onToggleFilters|sortLabel|onSort|onCrumb|sticky|style|key|ref|className|style|children)$/]",
        "message": "<SubNav> doesn't accept that prop. Declared props: breadcrumb, title, count, filtersVisible, onToggleFilters, sortLabel, onSort, onCrumb, sticky, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SwatchDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|active|size|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SwatchDot> doesn't accept that prop. Declared props: color, active, size, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UtilityBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|left|onLink|style|key|ref|className|style|children)$/]",
        "message": "<UtilityBar> doesn't accept that prop. Declared props: links, left, onLink, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
